          <mxGeometry x="280" y="240" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Output:&#10;&quot;Input tidak valid&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="275" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtotal" value="subtotal = harga x jumlah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="member" value="isMember = true ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="325" y="520" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="diskonY" value="diskon = 0.1 x subtotal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="diskonN" value="diskon = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="570" y="540" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="setelah" value="setelahDiskon =&#10;subtotal - diskon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="670" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ongkir" value="setelahDiskon &gt;= 250.000 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="285" y="770" width="280" height="130" as="geometry" />
