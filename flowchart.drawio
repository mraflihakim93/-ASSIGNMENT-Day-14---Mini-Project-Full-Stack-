        <mxCell id="ongkir0" value="ongkir = 0&#10;(gratis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="805" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ongkir15" value="ongkir = 15.000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="805" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="total" value="total = setelahDiskon + ongkir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
