        </mxCell>
        <mxCell id="input" value="Input: harga, jumlah, isMember" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="250" height="60" as="geometry" />
        </mxCell>
